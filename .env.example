# Copy to .env and fill in locally. Never commit real values.
# .gitignore ignores .env and .env.* except this file.
# Every value below is a placeholder.

# Frontend (Next.js). This is a public env var. Do not put secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Backend integrations. The settings module (app/config.py) is not in this
# snapshot; confirm the exact names there before a live run.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REDACTED
OPENAI_API_KEY=sk-REDACTED
YOUTUBE_API_KEY=REDACTED
BEEHIIV_API_KEY=REDACTED

# Browser destination after Google OAuth (settings.frontend_url in auth routes).
FRONTEND_URL=http://localhost:3000

# Contact / docs placeholder. Do not replace with a real inbox in git.
SUPPORT_EMAIL=support@example.com
